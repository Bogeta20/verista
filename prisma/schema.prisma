generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  role         Role     @default(GUEST) // GUEST, HOST, or BOTH
  createdAt    DateTime @default(now())

  listings     Listing[]
  bookingsMade Booking[]        @relation("GuestBookings")
  payoutInfo   HostPayoutInfo?
  sentMessages Message[]        @relation("SentMessages")
}

model HostPayoutInfo {
  id                     String @id @default(cuid())
  hostId                 String @unique
  host                   User   @relation(fields: [hostId], references: [id])
  bankName               String
  accountNumber          String
  paystackSubaccountCode String?
}

model Listing {
  id            String        @id @default(cuid())
  hostId        String
  host          User          @relation(fields: [hostId], references: [id])
  title         String
  description   String
  area          String // public-facing, e.g. "Lekki"
  address       String? // exact address — only ever returned
  // on bookings with status CONFIRMED
  latitude      Float?
  longitude     Float?
  accessNotes   String? // landmark-based directions
  houseRules    String?
  pricePerNight Int // stored in kobo
  amenities     String[] // keys like "wifi", "grid", "powergrid"
  discountTiers Json? // e.g. [{minNights:3,percentOff:10}]
  photos        String[] // S3 URLs
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())

  bookings Booking[]
  reviews  Review[]
  services Service[]
}

model Service {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  category    ServiceCategory
  name        String
  description String?
  price       Int // kobo
  priceType   String // "per_day" | "per_trip" | "per_stay" | "per_visit"

  bookingServices BookingService[]
}

model Booking {
  id               String        @id @default(cuid())
  listingId        String
  listing          Listing       @relation(fields: [listingId], references: [id])
  guestId          String
  guest            User          @relation("GuestBookings", fields: [guestId], references: [id])
  checkIn          DateTime
  checkOut         DateTime
  totalPrice       Int // kobo, what guest pays
  hostPayout       Int // kobo, after commission
  commissionAmount Int // kobo
  status           BookingStatus @default(PENDING)
  paymentReference String?
  createdAt        DateTime      @default(now())

  review   Review?
  services BookingService[]
  messages Message[]
}

model BookingService {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id])
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id])
  quantity   Int     @default(1)
  totalPrice Int // kobo
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

enum Role {
  GUEST
  HOST
  BOTH
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ServiceCategory {
  CHEF
  DRIVER
  FUEL_TOPUP
  CLEANING
  CUSTOM
}
