# Postgres connection used by Prisma
DATABASE_URL="postgresql://verista:verista@localhost:5432/verista_dev?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Paystack (test mode keys — https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# AWS S3 (bucket region: af-south-1)
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Verista's own Paystack account (commission destination)
VERISTA_PAYSTACK_MAIN_ACCOUNT=""
